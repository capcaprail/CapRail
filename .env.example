# ── Мережа ────────────────────────────────────────────────────────────────────
# Демо і розробка — devnet. Мейннет-ендпоінта тут немає навмисно: у цьому проєкті
# немає жодної операції, яку можна виконати в мейннеті без окремого рішення.
# Кластер у Helius задається піддоменом, не ключем: той самий ключ на
# `mainnet.helius-rpc.com` тихо перемкнув би індекс на іншу мережу.
DEVNET_RPC_URL=https://api.devnet.solana.com
DEVNET_WS_URL=wss://api.devnet.solana.com
# Запасний RPC для backfill worker-а, коли основний відмовляє. Необов'язковий.
DEVNET_RPC_FALLBACK_URL=

# ── Програма ──────────────────────────────────────────────────────────────────
# Адреси програми тут немає навмисно: вона береться тільки з вендорованого IDL
# (`packages/chain`). Друга адреса в оточенні дала б стан «IDL з одного деплою,
# адреса з іншого», якого нічим не спіймати.

# ── База ──────────────────────────────────────────────────────────────────────
# Supabase: рантайм через транзакційний pooler :6543 (`prepare: false`);
# міграції — через session pooler :5432, роль postgres. Пряме з'єднання — лише IPv6.
DATABASE_URL=postgres://postgres.REPLACE_ME:REPLACE_ME@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# ── API ───────────────────────────────────────────────────────────────────────
# Секрет підпису JWT входу гаманцем; ≥ 32 байти випадкових даних.
JWT_SECRET=REPLACE_ME
PORT=8787
LOG_LEVEL=info
# Походження сторінок, яким дозволено читати api. Кілька — через кому.
WEB_ORIGIN=http://localhost:5173

# ── Web ───────────────────────────────────────────────────────────────────────
# Читається під час збірки і потрапляє в бандл — секретів тут бути не може.
VITE_API_URL=http://localhost:8787
# Вузол, у який панель сама відправляє підписані транзакції. Публічний і без
# ключа: цю адресу бачить кожен, хто відкрив сторінку.
VITE_DEVNET_RPC_URL=https://api.devnet.solana.com
